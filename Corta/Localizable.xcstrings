    "remoteEdit.uploadFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploading “%1$@” to %2$@ failed: %3$@\n\nThe remote file was not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "上传“%1$@”到 %2$@ 失败：%3$@\n\n远程文件未被更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "上傳「%1$@」到 %2$@ 失敗：%3$@\n\n遠端檔案未被更動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%1$@」の %2$@ へのアップロードに失敗しました: %3$@\n\nリモートファイルは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@”을(를) %2$@(으)로 업로드하지 못했습니다: %3$@\n\n원격 파일은 변경되지 않았습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%1$@“ konnte nicht zu %2$@ hochgeladen werden: %3$@\n\nDie entfernte Datei wurde nicht geändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’envoi de « %1$@ » vers %2$@ a échoué : %3$@\n\nLe fichier distant n’a pas été modifié."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo subir «%1$@» a %2$@: %3$@\n\nEl archivo remoto no se modificó."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Falha ao enviar “%1$@” para %2$@: %3$@\n\nO arquivo remoto não foi alterado."
          }
        }
      }
    },
    "sftp.host.suggestedMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pane's shell reported that it is on “%@”. That name came from the remote shell's output, not from you — check it (or correct it to what you would pass to ssh), then connect:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此窗格的 shell 报告它位于“%@”。这个名字来自远端 shell 的输出，而不是你输入的——请核对（或改成你会传给 ssh 的写法），然后连接："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此面板的 shell 回報它位於「%@」。這個名稱來自遠端 shell 的輸出，而不是你輸入的——請核對（或改成你會傳給 ssh 的寫法），然後連線："
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このペインのシェルは「%@」上にあると報告しました。この名前はリモートシェルの出力から得たもので、あなたが入力したものではありません。確認（または ssh に渡す形に修正）してから接続してください:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 패널의 셸이 “%@”에 있다고 보고했습니다. 이 이름은 사용자가 입력한 것이 아니라 원격 셸의 출력에서 온 것입니다. 확인하거나 ssh에 전달할 형식으로 수정한 뒤 연결하세요:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Shell dieses Bereichs meldet, sie laufe auf „%@“. Dieser Name stammt aus der Ausgabe der entfernten Shell, nicht von Ihnen – prüfen Sie ihn (oder korrigieren Sie ihn zu dem, was Sie ssh übergeben würden) und verbinden Sie dann:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le shell de ce volet indique qu'il se trouve sur « %@ ». Ce nom provient de la sortie du shell distant, pas de vous : vérifiez-le (ou corrigez-le en ce que vous passeriez à ssh), puis connectez-vous :"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El shell de este panel informa que está en «%@». Ese nombre proviene de la salida del shell remoto, no de ti: compruébalo (o corrígelo a lo que pasarías a ssh) y luego conecta:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O shell deste painel informou que está em “%@”. Esse nome veio da saída do shell remoto, não de você — confira (ou corrija para o que você passaria ao ssh) e então conecte:"
          }
        }
      }
    },
    "remoteEdit.connect.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to “%@” to fetch this file?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "连接到“%@”以获取此文件？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "連線到「%@」以取得此檔案？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このファイルを取得するために「%@」に接続しますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 파일을 가져오기 위해 “%@”에 연결할까요?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mit „%@“ verbinden, um diese Datei zu laden?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se connecter à « %@ » pour récupérer ce fichier ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Conectar con «%@» para obtener este archivo?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conectar a “%@” para obter este arquivo?"
          }
        }
      }
    },
    "remoteEdit.connect.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta would run the system ssh to download %1$@ from %2$@ into a managed local copy. The host name is what the remote shell reported, not something you typed; connect only if it is the host you expect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Corta 将运行系统 ssh，把 %2$@ 上的 %1$@ 下载为受管本地副本。主机名来自远端 shell 的报告，不是你输入的；只有当它确实是你预期的主机时才连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Corta 將執行系統 ssh，把 %2$@ 上的 %1$@ 下載為受管的本機副本。主機名稱來自遠端 shell 的回報，並非你輸入的；只有在它確實是你預期的主機時才連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Corta はシステムの ssh を実行し、%2$@ 上の %1$@ を管理されたローカルコピーとしてダウンロードします。ホスト名はリモートシェルが報告したもので、あなたが入力したものではありません。想定どおりのホストである場合にのみ接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Corta가 시스템 ssh를 실행하여 %2$@의 %1$@을(를) 관리되는 로컬 사본으로 다운로드합니다. 호스트 이름은 원격 셸이 보고한 것이지 사용자가 입력한 것이 아닙니다. 예상한 호스트일 때만 연결하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Corta würde das System-ssh ausführen, um %1$@ von %2$@ in eine verwaltete lokale Kopie zu laden. Der Hostname stammt aus der Meldung der entfernten Shell, nicht aus Ihrer Eingabe; verbinden Sie nur, wenn es der erwartete Host ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Corta lancerait le ssh du système pour télécharger %1$@ depuis %2$@ dans une copie locale gérée. Le nom d'hôte est celui rapporté par le shell distant, pas quelque chose que vous avez saisi ; ne vous connectez que s'il s'agit bien de l'hôte attendu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Corta ejecutaría el ssh del sistema para descargar %1$@ desde %2$@ a una copia local gestionada. El nombre del host es el que informó el shell remoto, no algo que escribiste; conecta solo si es el host que esperas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Corta executaria o ssh do sistema para baixar %1$@ de %2$@ para uma cópia local gerenciada. O nome do host é o que o shell remoto informou, não algo que você digitou; conecte apenas se for o host esperado."
          }
        }
      }
    },
    "sftp.error.hostKey": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host key of %1$@ could not be verified:\n%2$@\n\nThe SFTP connection has no terminal, so ssh cannot ask you to accept a new or changed host key here. Connect once in the terminal to review and accept it, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法验证 %1$@ 的主机密钥：\n%2$@\n\nSFTP 连接没有终端，ssh 在这里无法请你接受新的或已变更的主机密钥。请先在终端里连接一次，审核并接受后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無法驗證 %1$@ 的主機金鑰：\n%2$@\n\nSFTP 連線沒有終端機，ssh 在這裡無法請你接受新的或已變更的主機金鑰。請先在終端機裡連線一次，審核並接受後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ のホスト鍵を検証できませんでした:\n%2$@\n\nSFTP 接続には端末がないため、ssh はここで新しい、または変更されたホスト鍵の受け入れを尋ねられません。先に端末で一度接続して確認・受け入れてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@의 호스트 키를 확인할 수 없습니다:\n%2$@\n\nSFTP 연결에는 터미널이 없어 ssh가 여기서 새 호스트 키나 변경된 호스트 키의 수락을 물을 수 없습니다. 먼저 터미널에서 한 번 연결해 검토하고 수락한 뒤 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Hostschlüssel von %1$@ konnte nicht überprüft werden:\n%2$@\n\nDie SFTP-Verbindung hat kein Terminal, daher kann ssh Sie hier nicht bitten, einen neuen oder geänderten Hostschlüssel zu akzeptieren. Verbinden Sie sich zuerst einmal im Terminal, prüfen und akzeptieren Sie ihn, und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La clé d'hôte de %1$@ n'a pas pu être vérifiée :\n%2$@\n\nLa connexion SFTP n'a pas de terminal : ssh ne peut donc pas vous demander ici d'accepter une clé d'hôte nouvelle ou modifiée. Connectez-vous d'abord une fois dans le terminal pour la vérifier et l'accepter, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo verificar la clave de host de %1$@:\n%2$@\n\nLa conexión SFTP no tiene terminal, así que ssh no puede pedirte aquí que aceptes una clave de host nueva o cambiada. Conecta primero una vez en el terminal para revisarla y aceptarla, y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A chave de host de %1$@ não pôde ser verificada:\n%2$@\n\nA conexão SFTP não tem terminal, então o ssh não pode pedir aqui que você aceite uma chave de host nova ou alterada. Conecte uma vez no terminal para revisá-la e aceitá-la, depois tente de novo."
          }
        }
      }
    },
    "sftp.conflict.directory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A folder (its files are compared one by one)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一个文件夹（其中的文件逐个比较）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一個資料夾（其中的檔案逐一比較）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォルダ（中のファイルは1つずつ比較されます）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "폴더(안의 파일은 하나씩 비교됩니다)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Ordner (seine Dateien werden einzeln verglichen)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un dossier (ses fichiers sont comparés un par un)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una carpeta (sus archivos se comparan uno a uno)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma pasta (seus arquivos são comparados um a um)"
          }
        }
      }
    },
    "sftp.conflict.directoryExists": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A folder with this name already exists here. Overwrite replaces files that exist in both; Resume continues interrupted files; Keep Both uses a new folder name; Skip transfers nothing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此处已有同名文件夹。覆盖会替换两边都有的文件；续传会继续被中断的文件；保留两者使用新文件夹名；跳过则不传输任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此處已有同名資料夾。覆寫會取代兩邊都有的檔案；續傳會繼續被中斷的檔案；保留兩者使用新資料夾名稱；略過則不傳輸任何內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "同名のフォルダが既にここにあります。上書きは両方にあるファイルを置き換え、再開は中断したファイルを続け、両方を保持は新しいフォルダ名を使い、スキップは何も転送しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "같은 이름의 폴더가 이미 있습니다. 덮어쓰기는 양쪽에 있는 파일을 교체하고, 재개는 중단된 파일을 이어가고, 둘 다 유지는 새 폴더 이름을 쓰고, 건너뛰기는 아무것도 전송하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Ordner mit diesem Namen existiert hier bereits. Überschreiben ersetzt Dateien, die auf beiden Seiten vorhanden sind; Fortsetzen setzt unterbrochene Dateien fort; Beide behalten verwendet einen neuen Ordnernamen; Überspringen überträgt nichts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un dossier de ce nom existe déjà ici. Remplacer écrase les fichiers présents des deux côtés ; Reprendre poursuit les fichiers interrompus ; Conserver les deux utilise un nouveau nom de dossier ; Ignorer ne transfère rien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ya existe aquí una carpeta con este nombre. Sobrescribir reemplaza los archivos presentes en ambos lados; Reanudar continúa los archivos interrumpidos; Conservar ambos usa un nombre de carpeta nuevo; Omitir no transfiere nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Já existe aqui uma pasta com este nome. Substituir troca os arquivos presentes em ambos os lados; Retomar continua os arquivos interrompidos; Manter ambos usa um novo nome de pasta; Ignorar não transfere nada."
          }
        }
      }
    },
