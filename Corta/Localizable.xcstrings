          "stringUnit" : {
            "state" : "translated",
            "value" : "Thermal state is reported by macOS, not a temperature in degrees. Disk space refers to the home volume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS informa niveles térmicos, no grados. El espacio corresponde al volumen de la carpeta personal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS indique un niveau thermique, pas une température. L’espace disque concerne le volume du dossier personnel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熱状態は macOS が報告する段階で、温度の数値ではありません。ディスク容量はホームのボリュームを示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열 상태는 macOS가 보고하는 단계이며 온도가 아닙니다. 디스크 공간은 홈 디렉터리 볼륨을 나타냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS informa níveis térmicos, não graus. O espaço corresponde ao volume da pasta pessoal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "热状态由 macOS 分档报告，并非摄氏温度。磁盘空间指主目录所在卷。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熱狀態由 macOS 分檔報告，並非攝氏溫度。磁碟空間指個人目錄所在卷宗。"
          }
        }
      }
    },
