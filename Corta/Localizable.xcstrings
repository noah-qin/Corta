          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una copia local anterior de %1$@ en %2$@ no figuraba en los registros de Corta, así que se conservó como %3$@ en lugar de reemplazarla. Puede contener cambios que nunca se subieron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une copie locale antérieure de %1$@ sur %2$@ n’était pas dans les registres de Corta ; elle a été conservée sous %3$@ au lieu d’être remplacée. Elle peut contenir des modifications jamais envoyées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%2$@ 上の %1$@ の以前のローカルコピーは Corta の記録になかったため、置き換えずに %3$@ として残しました。アップロードされていない編集が含まれている可能性があります。"
