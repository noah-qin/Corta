            "value": "%@, sem atalho"
          }
        }
      }
    },
    "shortcuts.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dash means the command has no key yet. Every shortcut can be changed with a bind. line in the config file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短横线表示该命令尚未绑定按键。所有快捷键都可通过配置文件中的 bind. 行修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "破折號表示該指令尚未綁定按鍵。所有快速鍵都可透過設定檔中的 bind. 行修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダッシュはキーが未割り当てのコマンドです。すべてのショートカットは設定ファイルの bind. 行で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대시는 아직 키가 없는 명령입니다. 모든 단축키는 설정 파일의 bind. 행으로 변경할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Strich bedeutet, dass der Befehl noch keine Taste hat. Jedes Kürzel lässt sich mit einer bind.-Zeile in der Konfigurationsdatei ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tiret signifie que la commande n’a pas encore de touche. Chaque raccourci se modifie avec une ligne bind. dans le fichier de configuration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un guion significa que el comando aún no tiene tecla. Cada atajo se cambia con una línea bind. en el archivo de configuración."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um travessão significa que o comando ainda não tem tecla. Cada atalho pode ser alterado com uma linha bind. no arquivo de configuração."
          }
        }
      }
    },
