    "space.ssh.remove.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Entfernen des lokalen Eintrags oder Projekts trennt nur SSH. Die entfernte tmux-Sitzung kann weiterhin Ressourcen verbrauchen. Verbinden Sie sich später mit demselben Rechner und führen Sie den passenden Befehl unten aus, um sie zu beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removing the local session or project only disconnects SSH. Its remote tmux session may continue consuming resources. To stop it later, connect to the same host and run the matching command below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eliminar el registro local o el proyecto solo desconecta SSH. La sesión tmux remota puede seguir consumiendo recursos. Para detenerla después, conéctese al mismo equipo y ejecute el comando correspondiente de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprimer l’entrée locale ou le projet déconnecte seulement SSH. La session tmux distante peut continuer à consommer des ressources. Pour l’arrêter ensuite, connectez-vous au même hôte et exécutez la commande correspondante ci-dessous."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ローカルの記録やプロジェクトを削除しても SSH を切断するだけです。リモートの tmux はリソースを消費し続ける場合があります。後で終了するには、同じホストに接続して下の対応するコマンドを実行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "로컬 기록이나 프로젝트를 제거하면 SSH만 연결 해제됩니다. 원격 tmux 세션은 계속 리소스를 사용할 수 있습니다. 나중에 종료하려면 같은 호스트에 연결하여 아래의 해당 명령을 실행하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Remover o registro local ou o projeto apenas desconecta o SSH. A sessão tmux remota pode continuar consumindo recursos. Para encerrá-la depois, conecte-se ao mesmo host e execute o comando correspondente abaixo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "移除本地会话或项目只断开 SSH，远端 tmux 可能继续占用资源。之后如需清理，请连接相同主机并执行对应的以下命令。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "移除本機工作階段或專案只會中斷 SSH，遠端 tmux 可能繼續佔用資源。之後如需清理，請連線至相同主機並執行下方對應的指令。"
          }
        }
      }
    },
