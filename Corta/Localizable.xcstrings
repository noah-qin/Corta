    "moveToApplications.newerMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diese Kopie ist älter. Sie zu bewegen würde die neuere ersetzen, daher tut Corta das nicht. Sie können stattdessen die installierte Version öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This copy is older. Moving it would replace the newer one, so Corta won’t. You can open the installed version instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta copia es más antigua. Moverla reemplazaría la más reciente, así que Corta no lo hará. Puedes abrir la versión instalada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cette copie est plus ancienne. La déplacer remplacerait la plus récente, Corta ne le fera donc pas. Vous pouvez ouvrir la version installée à la place."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このコピーは古いバージョンです。移動すると新しい方が置き換えられるため、Corta は移動しません。代わりにインストール済みのバージョンを開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 사본이 더 오래되었습니다. 옮기면 더 새로운 버전이 대체되므로 Corta는 옮기지 않습니다. 대신 설치된 버전을 열 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta cópia é mais antiga. Movê-la substituiria a mais recente, então o Corta não fará isso. Você pode abrir a versão instalada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前这份较旧。移动它会替换较新的版本，因此 Corta 不会这样做。你可以改为打开已安装的版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
