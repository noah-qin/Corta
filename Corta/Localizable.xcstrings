    "secureInput.indicator.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Keyboard Entry is on: other apps cannot observe what you type here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "安全键盘输入已开启：其他应用无法看到你在此输入的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "安全鍵盤輸入已開啟：其他應用程式無法看到你在此輸入的內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "セキュリティキーボード入力がオンです。他のアプリはここでの入力を監視できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "보안 키보드 입력이 켜져 있습니다. 다른 앱은 여기서 입력하는 내용을 볼 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sichere Tastatureingabe ist aktiv: Andere Apps können Ihre Eingaben hier nicht mitlesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La saisie clavier sécurisée est activée : les autres apps ne peuvent pas observer ce que vous tapez ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La entrada de teclado segura está activada: otras apps no pueden observar lo que escribes aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A entrada de teclado segura está ativada: outros apps não podem observar o que você digita aqui."
          }
        }
      }
    },
    "settings.help.secureKeyboardEntry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While a Corta window is in front, other processes cannot observe keystrokes. System-wide: it also blocks macro tools and text expanders while it is engaged. A lock in the titlebar shows when it is active."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当 Corta 窗口位于最前时，其他进程无法监听按键。系统级设置：生效期间也会阻止宏工具和文本扩展工具。标题栏中的锁形图标表示当前已生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "當 Corta 視窗位於最前時，其他程序無法監聽按鍵。系統層級設定：生效期間也會阻止巨集工具和文字展開工具。標題列中的鎖頭圖示表示目前已生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Corta のウインドウが最前面にある間、他のプロセスはキー入力を監視できません。システム全体に影響し、有効な間はマクロツールやテキスト展開ツールもブロックされます。有効中はタイトルバーに鍵が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Corta 윈도우가 앞에 있는 동안 다른 프로세스가 키 입력을 볼 수 없습니다. 시스템 전체 설정으로, 켜져 있는 동안 매크로 도구와 텍스트 확장 도구도 차단됩니다. 활성화되면 제목 막대에 잠금 아이콘이 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solange ein Corta-Fenster vorne ist, können andere Prozesse keine Tastenanschläge mitlesen. Systemweit: Auch Makro-Tools und Textbausteine sind währenddessen blockiert. Ein Schloss in der Titelleiste zeigt an, wenn es aktiv ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tant qu'une fenêtre Corta est au premier plan, les autres processus ne peuvent pas observer les frappes. Réglage système : il bloque aussi les outils de macros et d'expansion de texte. Un verrou dans la barre de titre indique qu'il est actif."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mientras una ventana de Corta está delante, otros procesos no pueden observar las pulsaciones. Es global: también bloquea herramientas de macros y expansores de texto mientras está activo. Un candado en la barra de título indica cuándo está activo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enquanto uma janela do Corta está à frente, outros processos não podem observar as teclas digitadas. Vale para todo o sistema: também bloqueia ferramentas de macro e expansores de texto enquanto ativo. Um cadeado na barra de título mostra quando está ativo."
          }
        }
      }
    },
