    "sftp.error.authentication": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication failed connecting to %1$@:\n%2$@\n\nThe SFTP connection has no terminal, so ssh cannot ask for a password or a key passphrase here. Use a key held by ssh-agent or the keychain, or connect once in the terminal first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "连接 %1$@ 时认证失败：\n%2$@\n\nSFTP 连接没有终端，ssh 在这里无法询问密码或密钥口令。请使用 ssh-agent 或钥匙串持有的密钥，或先在终端里连接一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "連線 %1$@ 時驗證失敗：\n%2$@\n\nSFTP 連線沒有終端機，ssh 在這裡無法詢問密碼或金鑰密語。請使用 ssh-agent 或鑰匙圈持有的金鑰，或先在終端機裡連線一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ への接続で認証に失敗しました:\n%2$@\n\nSFTP 接続には端末がないため、ssh はここでパスワードや鍵のパスフレーズを尋ねられません。ssh-agent かキーチェーンが保持する鍵を使うか、先に端末で一度接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@에 연결하는 중 인증에 실패했습니다:\n%2$@\n\nSFTP 연결에는 터미널이 없어 ssh가 여기서 암호나 키 암호 구문을 물을 수 없습니다. ssh-agent나 키체인이 보유한 키를 사용하거나, 먼저 터미널에서 한 번 연결하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Authentifizierung bei %1$@ fehlgeschlagen:\n%2$@\n\nDie SFTP-Verbindung hat kein Terminal, daher kann ssh hier weder nach einem Passwort noch nach einer Schlüssel-Passphrase fragen. Verwenden Sie einen Schlüssel aus ssh-agent oder dem Schlüsselbund, oder verbinden Sie sich zuerst einmal im Terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Échec de l'authentification auprès de %1$@ :\n%2$@\n\nLa connexion SFTP n'a pas de terminal : ssh ne peut donc demander ici ni mot de passe ni phrase secrète de clé. Utilisez une clé détenue par ssh-agent ou le trousseau, ou connectez-vous d'abord une fois dans le terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Falló la autenticación al conectar con %1$@:\n%2$@\n\nLa conexión SFTP no tiene terminal, así que ssh no puede pedir aquí una contraseña ni la frase de una clave. Usa una clave que tenga ssh-agent o el llavero, o conecta primero una vez en el terminal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Falha na autenticação ao conectar a %1$@:\n%2$@\n\nA conexão SFTP não tem terminal, então o ssh não pode pedir senha nem a frase-secreta de uma chave aqui. Use uma chave mantida pelo ssh-agent ou pelas chaves do sistema, ou conecte uma vez no terminal primeiro."
          }
        }
      }
    },
