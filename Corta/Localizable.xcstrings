    "remoteEdit.conflict.deletedMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„%1$@“ ist auf %2$@ nicht mehr vorhanden. Beim Laden: %3$@.\n\nHochladen erstellt sie mit dem Inhalt der lokalen Kopie neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” no longer exists on %2$@. At download it was: %3$@.\n\nUploading recreates it with the local copy's contents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%1$@» ya no existe en %2$@. Al descargar era: %3$@.\n\nSubir lo recrea con el contenido de la copia local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "« %1$@ » n’existe plus sur %2$@. Au téléchargement : %3$@.\n\nL’envoi le recrée avec le contenu de la copie locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「%1$@」は %2$@ にもう存在しません。ダウンロード時: %3$@。\n\nアップロードするとローカルコピーの内容で再作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%1$@”이(가) %2$@에 더 이상 없습니다. 다운로드 시점: %3$@.\n\n업로드하면 로컬 복사본 내용으로 다시 생성됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%1$@” não existe mais em %2$@. No download era: %3$@.\n\nEnviar o recria com o conteúdo da cópia local."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%1$@”在 %2$@ 上已不存在。下载时：%3$@。\n\n上传将以本地副本的内容重新创建它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「%1$@」在 %2$@ 上已不存在。下載時：%3$@。\n\n上傳將以本機副本的內容重新建立它。"
          }
        }
      }
    },
    "remoteEdit.conflict.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„%1$@“ auf %2$@ wurde seit dem Laden geändert.\n\nBeim Laden: %3$@\nEntfernt jetzt: %4$@\n\nHochladen ersetzt die entfernte Datei; erneutes Laden verwirft die lokalen Änderungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” on %2$@ changed since it was downloaded.\n\nAt download: %3$@\nRemote now: %4$@\n\nUploading overwrites the remote file; re-downloading discards the local edits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%1$@» en %2$@ cambió desde que se descargó.\n\nAl descargar: %3$@\nRemoto ahora: %4$@\n\nSubir sobrescribe el archivo remoto; volver a descargar descarta las ediciones locales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "« %1$@ » sur %2$@ a changé depuis son téléchargement.\n\nAu téléchargement : %3$@\nDistant maintenant : %4$@\n\nL’envoi remplace le fichier distant ; un nouveau téléchargement abandonne les modifications locales."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%2$@ の「%1$@」はダウンロード後に変更されました。\n\nダウンロード時: %3$@\n現在のリモート: %4$@\n\nアップロードするとリモートファイルを上書きします。再ダウンロードするとローカルの編集は破棄されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%2$@의 “%1$@”이(가) 다운로드된 후 변경되었습니다.\n\n다운로드 시점: %3$@\n현재 원격: %4$@\n\n업로드하면 원격 파일을 덮어쓰고, 다시 다운로드하면 로컬 편집 내용이 삭제됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%1$@” em %2$@ mudou desde que foi baixado.\n\nNo download: %3$@\nRemoto agora: %4$@\n\nEnviar sobrescreve o arquivo remoto; baixar novamente descarta as edições locais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%2$@ 上的“%1$@”在下载后已被更改。\n\n下载时：%3$@\n远程现在：%4$@\n\n上传会覆盖远程文件；重新下载会丢弃本地编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%2$@ 上的「%1$@」在下載後已被更動。\n\n下載時：%3$@\n遠端現在：%4$@\n\n上傳會覆蓋遠端檔案；重新下載會捨棄本機編輯。"
          }
        }
      }
    },
