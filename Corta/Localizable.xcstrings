    "failure.reconnectHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect starts a new connection to the same host. Nothing from the previous session is restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“重新连接”会建立到同一台主机的新连接，不会恢复先前会话的任何状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「重新連線」會建立到同一台主機的新連線，不會恢復先前工作階段的任何狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「再接続」は同じホストへの新しい接続を開始します。以前のセッションの状態は復元されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다시 연결은 같은 호스트와 새로운 연결을 시작합니다. 이전 세션의 상태는 복원되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neu verbinden startet eine neue Verbindung zum selben Host. Nichts aus der vorherigen Sitzung wird wiederhergestellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reconnecter établit une nouvelle connexion vers le même hôte. Rien de la session précédente n’est restauré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reconectar inicia una conexión nueva con el mismo host. No se restaura nada de la sesión anterior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reconectar inicia uma nova conexão com o mesmo host. Nada da sessão anterior é restaurado."
          }
        }
      }
    },
