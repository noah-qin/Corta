          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stattdessen %@ gestartet – die konfigurierte Login-Shell ließ sich nicht ausführen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancement de %@ à la place : le shell de connexion configuré n’a pas pu s’exécuter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se inició %@ en su lugar: el shell de inicio configurado no pudo ejecutarse."
