    "settings.status.clamped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ must be between %2$@ and %3$@ — saved as %4$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 必须在 %2$@ 和 %3$@ 之间——已保存为 %4$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 必須介於 %2$@ 與 %3$@ 之間——已儲存為 %4$@。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は %2$@ 〜 %3$@ の範囲が必要です。%4$@ として保存しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) %2$@에서 %3$@ 사이여야 합니다 — %4$@(으)로 저장했습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ muss zwischen %2$@ und %3$@ liegen – als %4$@ gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ doit être entre %2$@ et %3$@ : enregistré comme %4$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ debe estar entre %2$@ y %3$@: se guardó como %4$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ deve estar entre %2$@ e %3$@ — salvo como %4$@."
          }
        }
      }
    },
