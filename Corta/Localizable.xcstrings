    "settings.help.quickTerminal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default: the key is claimed in every application. The panel is always available from View ▸ Quick Terminal, the command palette and the Shortcuts app; this only adds the hotkey."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "默认关闭：该按键会在所有应用中被占用。面板始终可通过“显示 ▸ 快捷终端”、命令面板和“快捷指令”打开；此设置只负责添加热键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "預設關閉：該按鍵會在所有應用程式中被佔用。面板始終可透過「檢視 ▸ 快捷終端機」、指令面板和「捷徑」開啟；此設定只負責加入快速鍵。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "デフォルトはオフ: キーはすべてのアプリで占有されます。パネルは常に「表示 ▸ クイックターミナル」、コマンドパレット、ショートカットアプリから開けます。この設定はホットキーを追加するだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기본값은 꺼짐: 이 키는 모든 앱에서 점유됩니다. 패널은 항상 보기 ▸ 퀵 터미널, 명령 팔레트, 단축어 앱에서 열 수 있으며 이 설정은 단축키만 추가합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Standardmäßig aus: Die Taste wird in jeder App belegt. Das Panel ist immer über Darstellung ▸ Schnellterminal, die Befehlspalette und die Kurzbefehle-App erreichbar; hier wird nur der Kurzbefehl hinzugefügt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactivé par défaut : la touche est réservée dans toutes les apps. Le panneau reste accessible via Présentation ▸ Terminal rapide, la palette de commandes et l'app Raccourcis ; ce réglage ajoute seulement le raccourci."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desactivado por defecto: la tecla se reserva en todas las apps. El panel siempre está disponible desde Visualización ▸ Terminal rápido, la paleta de comandos y la app Atajos; esto solo añade el atajo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desativado por padrão: a tecla é reservada em todos os apps. O painel está sempre disponível em Visualização ▸ Terminal rápido, na paleta de comandos e no app Atalhos; isto só adiciona o atalho."
          }
        }
      }
    },
    "settings.status.quickTerminalOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No key is claimed. View ▸ Quick Terminal still opens it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未占用任何按键。仍可通过“显示 ▸ 快捷终端”打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
