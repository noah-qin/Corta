    "remoteEdit.changed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local copy of “%1$@” on %2$@ was edited. Upload the changes to the remote file?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$@ 上“%1$@”的本地副本已被编辑。要将更改上传到远程文件吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$@ 上「%1$@」的本機副本已被編輯。要將更動上傳到遠端檔案嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$@ の「%1$@」のローカルコピーが編集されました。変更をリモートファイルにアップロードしますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%2$@의 “%1$@” 로컬 복사본이 편집되었습니다. 변경 사항을 원격 파일에 업로드하시겠습니까?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die lokale Kopie von „%1$@“ auf %2$@ wurde bearbeitet. Die Änderungen in die entfernte Datei hochladen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
