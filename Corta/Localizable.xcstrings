    "settings.help.optionAsMeta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends an Escape prefix instead of composing the layout's alternate characters. Leave off for international layouts and dead keys."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "发送 Escape 前缀，而不是输入键盘布局的替代字符。使用国际键盘布局和死键时请保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "傳送 Escape 前綴，而不是輸入鍵盤佈局的替代字元。使用國際鍵盤佈局和附加符號鍵時請保持關閉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "レイアウトの代替文字を入力する代わりに Escape プレフィックスを送信します。各国語レイアウトやデッドキーを使う場合はオフのままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "레이아웃의 대체 문자를 입력하는 대신 Escape 접두사를 보냅니다. 국제 키보드 레이아웃과 데드 키를 사용하는 경우 꺼 두십시오."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sendet ein Escape-Präfix, statt die Alternativzeichen der Tastaturbelegung zu erzeugen. Bei internationalen Belegungen und Tottasten ausgeschaltet lassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envoie un préfixe Escape au lieu de composer les caractères alternatifs de la disposition. À laisser désactivé pour les dispositions internationales et les touches mortes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envía un prefijo Escape en lugar de componer los caracteres alternativos de la distribución. Déjalo desactivado para distribuciones internacionales y teclas muertas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envia um prefixo Escape em vez de compor os caracteres alternativos do layout. Deixe desativado para layouts internacionais e teclas mortas."
          }
        }
      }
    },
