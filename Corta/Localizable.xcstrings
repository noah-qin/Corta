    "space.ssh.ready.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Programme dieser entfernten tmux-Sitzung laufen nach einer SSH-Trennung, dem Schließen des Bereichs oder Fensters und dem Beenden von Corta weiter. Bildschirm und Verlauf bleiben auf dem Server und unterliegen dessen tmux-Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This remote tmux session keeps its programs running after SSH disconnects, the panel or window closes, or Corta quits. Its screen and history live on the server, subject to remote tmux settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los programas de esta sesión tmux remota siguen activos tras desconectar SSH, cerrar el panel o la ventana, o salir de Corta. La pantalla y el historial permanecen en el servidor según sus ajustes de tmux."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les programmes de cette session tmux distante continuent après une déconnexion SSH, la fermeture du panneau ou de la fenêtre, ou l’arrêt de Corta. L’écran et l’historique restent sur le serveur selon ses réglages tmux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このリモート tmux セッション内のプログラムは、SSH の切断、パネルやウインドウの閉鎖、Corta の終了後も動作します。画面と履歴はサーバーに保持され、リモートの tmux 設定に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 원격 tmux 세션의 프로그램은 SSH 연결 해제, 패널이나 윈도우 닫기, Corta 종료 후에도 실행됩니다. 화면과 기록은 서버에 남으며 원격 tmux 설정의 제한을 받습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os programas desta sessão tmux remota continuam após desconectar o SSH, fechar o painel ou a janela, ou sair do Corta. A tela e o histórico ficam no servidor, sujeitos às configurações remotas do tmux."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此远端 tmux 会话在 SSH 断线、关闭面板或窗口、退出 Corta 后保留其中的程序。屏幕与历史由远端维护，历史长度受远端 tmux 配置约束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此遠端 tmux 工作階段在 SSH 中斷、關閉面板或視窗、結束 Corta 後保留其中的程式。畫面與歷史由遠端維護，歷史長度受遠端 tmux 設定約束。"
          }
        }
      }
    },
