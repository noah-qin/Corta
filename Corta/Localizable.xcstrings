    "space.ssh.failed.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erstellen oder Verbinden der tmux-Sitzung fehlgeschlagen (Exit-Status %lld). Eine normale Login-Shell wird verwendet; die Wiederherstellung ist eingeschränkt. Entfernter Fehler:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux creation or attachment failed (exit status %lld). Using an ordinary login shell; recovery is limited. Remote error:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ha fallado la creación o conexión de tmux (código de salida %lld). Se usa un shell de inicio de sesión normal; la recuperación es limitada. Error remoto:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La création ou le rattachement tmux a échoué (code de sortie %lld). Un shell de connexion ordinaire est utilisé ; la restauration est limitée. Erreur distante :"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tmux の作成または接続に失敗しました（終了コード %lld）。通常のログインシェルを使用し、復元には制限があります。リモートエラー："
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "tmux 생성 또는 연결에 실패했습니다(종료 코드 %lld). 일반 로그인 셸을 사용하며 복원이 제한됩니다. 원격 오류:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Falha ao criar ou conectar o tmux (código de saída %lld). Um shell de login comum está em uso; a recuperação é limitada. Erro remoto:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
