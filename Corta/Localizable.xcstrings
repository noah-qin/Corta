    "about.version.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select to copy — this is the line a bug report needs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择并复制——提交错误报告时需要这一行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選取並複製——提交錯誤報告時需要這一行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選択してコピーしてください。バグ報告に必要な行です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선택하여 복사하세요. 버그 신고에 필요한 줄입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zum Kopieren auswählen – diese Zeile wird für Fehlerberichte benötigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sélectionnez pour copier — cette ligne est nécessaire pour signaler un bug."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selecciona para copiar; esta línea se necesita para informar de errores."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selecione para copiar — esta linha é necessária em relatórios de bugs."
          }
        }
      }
    },
