    "sftp.delete.message.directory" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den Ordner „%1$@“ auf %2$@ löschen? Er enthält %3$ld Einträge. Ein Ordner muss leer sein, um gelöscht werden zu können, und das Löschen kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete the folder “%1$@” on %2$@? It contains %3$ld entries. A folder must be empty before it can be deleted, and deletion cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Eliminar la carpeta «%1$@» en %2$@? Contiene %3$ld elementos. Una carpeta debe estar vacía para poder eliminarla, y la eliminación no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprimer le dossier « %1$@ » sur %2$@ ? Il contient %3$ld éléments. Un dossier doit être vide pour pouvoir être supprimé, et la suppression est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%2$@ のフォルダ「%1$@」を削除しますか? %3$ld 件の項目が含まれています。フォルダは空でないと削除できず、削除は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%2$@의 폴더 “%1$@”을(를) 삭제하시겠습니까? 항목 %3$ld개가 들어 있습니다. 폴더는 비어 있어야 삭제할 수 있으며 삭제는 되돌릴 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apagar a pasta “%1$@” em %2$@? Ela contém %3$ld itens. Uma pasta precisa estar vazia para ser apagada, e a exclusão não pode ser desfeita."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "要删除 %2$@ 上的文件夹“%1$@”吗？其中包含 %3$ld 个条目。文件夹必须为空才能删除，且删除无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "要刪除 %2$@ 上的檔案夾「%1$@」嗎？其中包含 %3$ld 個項目。檔案夾必須為空才能刪除，且刪除無法復原。"
          }
        }
      }
    },
