          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”은(는) 글자 폭이 균일하지 않아 사용할 수 없습니다 — 대신 시스템 고정폭 글꼴을 사용합니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ hat keinen gleichmäßigen Zeichenabstand und kann nicht verwendet werden – stattdessen wird die System-Festbreitenschrift verwendet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« %@ » n'avance pas de façon régulière et ne peut pas être utilisée — utilisation de la police à chasse fixe du système à la place"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” no avanza de forma uniforme y no se puede usar; se usa la fuente monoespaciada del sistema en su lugar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
