    "paste.newlines.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The application in the terminal has not enabled bracketed paste mode, so each line will execute as if you typed it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "终端中的应用未启用括号粘贴模式，因此每一行都会像手动输入一样执行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "終端中的應用程式未啟用括號貼上模式，因此每一行都會像手動輸入一樣執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ターミナルのアプリケーションでブラケットペーストが有効になっていないため、各行は入力した場合と同様に実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "터미널 애플리케이션에서 괄호 붙여넣기 모드가 활성화되지 않아 각 줄이 입력한 것처럼 실행됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Anwendung im Terminal unterstützt keinen geklammerten Einfügemodus. Jede Zeile wird wie eine Eingabe ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’application du terminal n’a pas activé le collage entre crochets ; chaque ligne sera exécutée comme si elle avait été saisie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La aplicación del terminal no ha activado el pegado entre corchetes; cada línea se ejecutará como si la hubieras escrito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O aplicativo no terminal não ativou o modo de colagem entre colchetes; cada linha será executada como se tivesse sido digitada."
          }
        }
      }
    },
