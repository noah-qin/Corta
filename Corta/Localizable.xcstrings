    "settings.help.shellIntegration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets Corta see where each command starts, ends and whether it failed. Installs into ~/.zshrc, reversibly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 Corta 知道每条命令在哪里开始、结束及是否失败。以可逆的方式安装到 ~/.zshrc。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 Corta 知道每個命令在哪裡開始、結束以及是否失敗。以可還原的方式安裝到 ~/.zshrc。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各コマンドの開始位置、終了位置、失敗したかどうかを Corta が把握できるようになります。~/.zshrc に可逆的にインストールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 명령이 어디서 시작되고 끝났는지, 실패했는지를 Corta가 알 수 있게 합니다. ~/.zshrc에 되돌릴 수 있게 설치됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht Corta zu erkennen, wo jeder Befehl beginnt, endet und ob er fehlgeschlagen ist. Wird reversibel in ~/.zshrc installiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à Corta de savoir où chaque commande commence, se termine et si elle a échoué. Installation réversible dans ~/.zshrc."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Corta sepa dónde empieza y termina cada comando, y si falló. Se instala de forma reversible en ~/.zshrc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que o Corta saiba onde cada comando começa, termina e se falhou. Instalado de forma reversível em ~/.zshrc."
          }
        }
      }
    },
