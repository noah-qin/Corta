    "sftp.error.protocol": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sent data that is not valid SFTP, and the connection was dropped: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ 发送了无效的 SFTP 数据，连接已断开：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ 傳送了無效的 SFTP 資料，連線已中斷：%2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ が無効な SFTP データを送信したため、接続を切断しました: %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@이(가) 유효하지 않은 SFTP 데이터를 보내 연결을 끊었습니다: %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ hat ungültige SFTP-Daten gesendet; die Verbindung wurde getrennt: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ a envoyé des données SFTP invalides ; la connexion a été interrompue : %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ envió datos que no son SFTP válidos y se cerró la conexión: %2$@"
          }
