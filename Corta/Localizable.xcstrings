    "settings.help.allowClipboardCopy" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erlaubt Programmen, Text in die Zwischenablage zu schreiben. Lesen ist nie erlaubt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets a program put text on the clipboard. Reading is never allowed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que un programa escriba texto en el portapapeles. Nunca se permite leerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permet à un programme d’écrire dans le presse-papiers. La lecture n’est jamais autorisée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "プログラムによるクリップボードへの書き込みを許可します。読み取りは常に許可されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "프로그램이 클립보드에 텍스트를 쓸 수 있게 합니다. 읽기는 허용되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que um programa grave texto na área de transferência. A leitura nunca é permitida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许程序将文本写入剪贴板，但永远不允许读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "允許程式將文字寫入剪貼簿，但永遠不允許讀取。"
          }
        }
      }
    },
    "settings.help.ambiguousWidth" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeichen wie ±, §, Griechisch und Kyrillisch. Gilt für Ausgaben nach der Änderung; Programme, die selbst messen, zählen sie womöglich weiter als eine Zelle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Characters such as ±, §, Greek and Cyrillic. Applies to output written after the change; programs that measure text themselves may still count them as one cell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Caracteres como ±, §, griego y cirílico. Se aplica a la salida escrita después del cambio; los programas que miden por su cuenta pueden seguir contándolos como una celda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Des caractères comme ±, §, le grec et le cyrillique. S’applique à la sortie écrite après le changement ; les programmes qui mesurent eux-mêmes peuvent encore les compter comme une cellule."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "±、§、ギリシャ文字やキリル文字など。変更後の出力に適用されます。自分で幅を数えるプログラムは 1 マスとして扱う場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "±, §, 그리스 문자, 키릴 문자 등. 변경 후 출력에 적용됩니다. 너비를 직접 계산하는 프로그램은 여전히 1칸으로 셀 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Caracteres como ±, §, grego e cirílico. Vale para a saída escrita após a mudança; programas que medem por conta própria ainda podem contá-los como uma célula."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "如 ±、§、希腊字母和西里尔字母。只影响更改之后的输出；自行计算宽度的程序可能仍按 1 格计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "如 ±、§、希臘字母與西里爾字母。只影響變更之後的輸出；自行計算寬度的程式可能仍以 1 格計算。"
          }
        }
      }
    },
    "settings.help.cjkFont" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chinesische, japanische und koreanische Zeichen, die der Schrift fehlen, werden in dieser Schrift gezeichnet. Zellgröße und Grundlinie bleiben die der Schrift."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chinese, Japanese and Korean characters the font lacks are drawn in this font. The font keeps the cell size and baseline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los caracteres chinos, japoneses y coreanos que le faltan a la fuente se dibujan con esta. El tamaño de celda y la línea base siguen siendo los de la fuente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les caractères chinois, japonais et coréens absents de la police sont dessinés avec celle-ci. La taille des cellules et la ligne de base restent celles de la police."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "フォントにない中国語・日本語・韓国語の文字をこのフォントで表示します。セルの大きさとベースラインはメインのフォントに従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "글꼴에 없는 중국어, 일본어, 한국어 문자를 이 글꼴로 그립니다. 셀 크기와 기준선은 기본 글꼴을 따릅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Caracteres chineses, japoneses e coreanos que faltam na fonte são desenhados com esta. O tamanho da célula e a linha de base continuam os da fonte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "字体缺少的中文、日文和韩文字符用这款字体绘制。格子大小和基线仍由主字体决定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "字型缺少的中文、日文與韓文字元以這款字型繪製。格子大小與基線仍由主字型決定。"
          }
        }
      }
    },
