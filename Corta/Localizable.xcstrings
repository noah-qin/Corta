    "inputSource.color.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "#RGB oder #RRGGBB; leer lassen für einen dezenten Standardstil. Unbekannte IME-Modi verwenden eine neutrale Farbe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use #RGB or #RRGGBB; leave empty for subtle default styling. Unknown IME modes use a neutral color."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "#RGB o #RRGGBB; déjalo vacío para un estilo discreto. Los modos IME desconocidos usan un color neutro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "#RGB ou #RRGGBB ; laisser vide pour un style discret. Les modes IME inconnus utilisent une couleur neutre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "#RGB または #RRGGBB。空欄で控えめな標準スタイル。判別できないモードは中立色。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "#RGB 또는 #RRGGBB를 입력하세요. 비워 두면 차분한 기본 스타일을 사용합니다. 확인할 수 없는 IME 모드는 중립 색상으로 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "#RGB ou #RRGGBB; deixe vazio para um estilo discreto. Modos IME desconhecidos usam uma cor neutra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填写 #RGB 或 #RRGGBB；留空使用低干扰的默认样式。无法确认的输入法模式使用中性色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填寫 #RGB 或 #RRGGBB；留空使用低干擾的預設樣式。無法確認的輸入法模式使用中性色。"
          }
        }
      }
    },
