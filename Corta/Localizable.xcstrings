    "Shows the Quick Terminal if it is hidden, and hides it if it is showing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeigt das Schnellterminal, wenn es ausgeblendet ist, und blendet es aus, wenn es sichtbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the Quick Terminal if it is hidden, and hides it if it is showing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Muestra el terminal rápido si está oculto y lo oculta si está visible."
