    "settings.help.allowClipboardCopy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets a program put text on the clipboard. Reading is never allowed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许程序将文本写入剪贴板，但永远不允许读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許程式將文字寫入剪貼簿，但永遠不允許讀取。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プログラムによるクリップボードへの書き込みを許可します。読み取りは常に許可されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로그램이 클립보드에 텍스트를 쓸 수 있게 합니다. 읽기는 허용되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt Programmen, Text in die Zwischenablage zu schreiben. Lesen ist nie erlaubt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à un programme d’écrire dans le presse-papiers. La lecture n’est jamais autorisée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que un programa escriba texto en el portapapeles. Nunca se permite leerlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que um programa grave texto na área de transferência. A leitura nunca é permitida."
          }
        }
      }
    },
    "settings.help.confirmClose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask when a pane still has something running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "pane 中仍有任务运行时询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "窗格仍有工作執行時詢問。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペインで処理が実行中の場合に確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페인에 실행 중인 작업이 있으면 묻습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen, wenn in einem Bereich noch etwas läuft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander si un volet contient encore une tâche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar si un panel aún está ocupado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntar quando um painel ainda estiver em execução."
          }
        }
      }
    },
    "settings.help.font": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta uses the system monospaced face. To use another, set font-family in the config file below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta 使用系统等宽字体。若要使用其他字体，请在下方的配置文件中设置 font-family。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta 使用系統等寬字體。若要使用其他字體，請在下方的設定檔中設定 font-family。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta はシステムの等幅書体を使います。別の書体を使うには、下の設定ファイルで font-family を指定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta는 시스템 고정폭 서체를 사용합니다. 다른 서체를 쓰려면 아래 설정 파일에서 font-family를 지정하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta verwendet die monospaced Systemschrift. Für eine andere setze font-family in der Konfigurationsdatei unten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta utilise la police à largeur fixe du système. Pour une autre, définissez font-family dans le fichier de configuration ci-dessous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta usa la tipografía monoespaciada del sistema. Para otra, define font-family en el archivo de configuración de abajo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Corta usa a fonte monoespaçada do sistema. Para outra, defina font-family no arquivo de configuração abaixo."
          }
        }
      }
    },
    "settings.help.newWindow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Columns × rows. The window's pixel size follows the font."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列 × 行。窗口像素大小会随字体变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "欄 × 列。視窗像素大小會隨字型變化。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "列 × 行。ウィンドウのピクセルサイズはフォントに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열 × 행. 윈도우 픽셀 크기는 글꼴에 따라 결정됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spalten × Zeilen. Die Fenstergröße folgt der Schrift."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colonnes × lignes. La taille de la fenêtre suit la police."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Columnas × filas. El tamaño de la ventana depende de la fuente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colunas × linhas. O tamanho da janela acompanha a fonte."
          }
        }
      }
    },
    "settings.help.notifyOnLongTasks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only while the window is in the background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在窗口处于后台时通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在視窗位於背景時通知。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウがバックグラウンドにある場合のみ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우가 백그라운드에 있을 때만 알립니다."
          }
        },
        "de": {
