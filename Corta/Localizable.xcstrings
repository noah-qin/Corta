        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%2$@의 %1$@에 대한 이전 로컬 사본이 Corta 기록에 없어서 교체하지 않고 %3$@(으)로 보관했습니다. 업로드되지 않은 편집이 들어 있을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uma cópia local anterior de %1$@ em %2$@ não estava nos registros do Corta, então foi mantida como %3$@ em vez de ser substituída. Ela pode conter edições nunca enviadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 上 %1$@ 的一份较早的本地副本不在 Corta 的记录中，因此已保留为 %3$@，而没有被替换。其中可能有尚未上传的修改。"
