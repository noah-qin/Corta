    "status.memory.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speicher: fest zugeordnete, nicht löschbare anonyme und komprimierte Seiten; ohne Dateicache."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memory: wired + non-purgeable anonymous + compressed pages; file cache excluded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoria: páginas fijas, anónimas no purgables y comprimidas; excluye la caché de archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mémoire : pages câblées, anonymes non purgeables et compressées ; cache de fichiers exclu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリ：固定ページ、消去できない匿名ページ、圧縮ページの合計。ファイルキャッシュは除きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모리: 고정 페이지, 제거 불가 익명 페이지, 압축 페이지의 합계입니다. 파일 캐시는 제외됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memória: páginas fixas, anônimas não elimináveis e compactadas; sem cache de arquivos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内存：固定页、不可清除的匿名页与压缩页之和，不含文件缓存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記憶體：固定頁、不可清除的匿名頁與壓縮頁之和，不含檔案快取。"
          }
        }
      }
    },
    "status.network.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "auto wählt eine primäre Schnittstelle. Alternativ z. B. en0 eingeben. VPN und physischer Verkehr werden nicht addiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "auto selects one primary interface. Enter en0 or another interface to override. VPN and physical traffic are not added together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "auto elige una interfaz principal. Puedes indicar en0 u otra interfaz. No se suman el tráfico VPN y el físico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "auto choisit une interface principale. Saisissez en0 ou une autre interface pour la remplacer. Les trafics VPN et physique ne sont pas additionnés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "auto は主要なインターフェイスを1つ選びます。en0 などを指定できます。VPN と物理インターフェイスの通信量は合算しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "auto는 기본 인터페이스 하나를 선택합니다. en0 등을 입력할 수 있습니다. VPN과 물리 인터페이스 트래픽은 합산하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "auto escolhe uma interface principal. Digite en0 ou outra interface para substituir. Tráfego VPN e físico não são somados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "auto 选择一个主要接口，也可填写 en0 等接口名。VPN 与物理网卡流量不会相加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "auto 選擇一個主要介面，也可填寫 en0 等介面名稱。VPN 與實體網卡流量不會相加。"
          }
        }
      }
    },
