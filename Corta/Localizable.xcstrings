    "moveToApplications.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta works best from your Applications folder — checking for updates and reopening from Spotlight both expect it there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta 在\"应用程序\"文件夹里运行效果最好——检查更新和从聚焦搜索重新打开都依赖这个位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta 在「應用程式」資料夾中運作效果最好——檢查更新和從聚焦搜尋重新開啟都依賴這個位置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cortaは「アプリケーション」フォルダにあるときに最も適切に動作します。アップデートの確認やSpotlightからの再起動もこの場所を前提としています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta는 응용 프로그램 폴더에 있을 때 가장 잘 작동합니다. 업데이트 확인과 Spotlight를 통한 재실행 모두 이 위치를 전제로 합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta funktioniert am besten im Programme-Ordner – sowohl die Update-Prüfung als auch das erneute Öffnen über Spotlight setzen diesen Ort voraus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta fonctionne mieux depuis le dossier Applications — la recherche de mises à jour et la réouverture depuis Spotlight s'attendent à cet emplacement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta funciona mejor desde la carpeta Aplicaciones: tanto la búsqueda de actualizaciones como reabrirlo desde Spotlight dan por hecho esa ubicación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Corta funciona melhor na pasta Aplicativos — tanto a verificação de atualizações quanto reabrir pelo Spotlight partem do princípio de que ele está lá."
          }
        }
      }
    },
