    "close.running.multiple": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ are still running and will be terminated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@仍在运行，关闭后将终止它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@仍在執行，關閉後將終止它們。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@が実行中です。閉じると終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@이(가) 실행 중이며 닫으면 종료됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ laufen noch und werden beendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ sont encore actifs et seront terminés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ siguen en ejecución y se terminarán."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ainda estão em execução e serão encerrados."
          }
        }
      }
    },
    "close.running.single": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A process is still running and will be terminated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仍有一个进程在运行，关闭后将终止它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仍有一個程序正在執行，關閉後將終止它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "プロセスが実行中です。閉じると終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "프로세스가 실행 중이며 닫으면 종료됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Prozess läuft noch und wird beendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un processus est encore actif et sera terminé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hay un proceso en ejecución y se terminará."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um processo ainda está em execução e será encerrado."
          }
        }
      }
    },
    "close.running.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close %@ while something is running?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仍有任务运行，要关闭%@吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仍有工作執行中，要關閉%@嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "実行中の処理があります。%@を閉じますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "실행 중인 작업이 있습니다. %@을(를) 닫을까요?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ schließen, während noch etwas läuft?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fermer %@ alors qu’une tâche est en cours ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Cerrar %@ mientras hay algo en ejecución?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fechar %@ enquanto algo está em execução?"
          }
        }
      }
    },
