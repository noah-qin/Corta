  "strings": {
    "a11y.terminal.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d rows by %2$d columns. Cursor on row %3$d, column %4$d."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$d 行 × %2$d 列。光标位于第 %3$d 行第 %4$d 列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$d 列 × %2$d 欄。游標位於第 %3$d 列第 %4$d 欄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$d 行 × %2$d 桁。カーソルは %3$d 行 %4$d 桁。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$d행 × %2$d열. 커서는 %3$d행 %4$d열."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$d Zeilen × %2$d Spalten. Cursor in Zeile %3$d, Spalte %4$d."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$d lignes sur %2$d colonnes. Curseur ligne %3$d, colonne %4$d."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$d filas por %2$d columnas. Cursor en la fila %3$d, columna %4$d."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$d linhas por %2$d colunas. Cursor na linha %3$d, coluna %4$d."
          }
        }
      }
    },
