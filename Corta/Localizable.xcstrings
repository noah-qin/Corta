          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새 Corta 터미널 윈도우를 홈 폴더 또는 선택한 폴더에서 엽니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffnet ein neues Corta-Terminalfenster in Ihrem Benutzerordner oder einem gewählten Ordner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvre une nouvelle fenêtre de terminal Corta, dans votre dossier de départ ou un dossier de votre choix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre una nueva ventana de terminal de Corta, en tu carpeta de inicio o en la que elijas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre uma nova janela de terminal do Corta, na sua pasta pessoal ou em uma pasta à sua escolha."
