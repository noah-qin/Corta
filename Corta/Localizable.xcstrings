    "Opens a new Corta terminal window, in your home directory or in a folder you choose.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a new Corta terminal window, in your home directory or in a folder you choose."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打开一个新的 Corta 终端窗口，位于你的个人文件夹或你选择的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "開啟一個新的 Corta 終端機視窗，位於你的個人檔案夾或你選擇的檔案夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
