    "askpass.hostKey.advice" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vertrauen Sie ihm nur, wenn der Fingerabdruck oben mit dem übereinstimmt, den Ihnen der Administrator des Servers genannt hat. OpenSSH speichert ihn dann in ~/.ssh/known_hosts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trust it only if the fingerprint above matches the one the server’s administrator gave you. OpenSSH then saves it to ~/.ssh/known_hosts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Confía solo si la huella de arriba coincide con la que te dio el administrador del servidor. OpenSSH la guardará entonces en ~/.ssh/known_hosts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ne lui faites confiance que si l'empreinte ci-dessus correspond à celle que l'administrateur du serveur vous a donnée. OpenSSH l'enregistre ensuite dans ~/.ssh/known_hosts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "上の指紋がサーバ管理者から伝えられたものと一致する場合にだけ信頼してください。OpenSSH はそれを ~/.ssh/known_hosts に保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "위 지문이 서버 관리자가 알려 준 것과 일치할 때만 신뢰하세요. 그러면 OpenSSH가 ~/.ssh/known_hosts에 저장합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Confie apenas se a impressão digital acima corresponder à que o administrador do servidor lhe deu. O OpenSSH então a salva em ~/.ssh/known_hosts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在上面的指纹与服务器管理员提供的一致时才信任。之后 OpenSSH 会把它保存到 ~/.ssh/known_hosts。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "只有在上面的指紋與伺服器管理員提供的一致時才信任。之後 OpenSSH 會把它儲存到 ~/.ssh/known_hosts。"
          }
        }
      }
    },
