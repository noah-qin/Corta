          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "점유된 키가 없습니다. 보기 ▸ 퀵 터미널로 열 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine Taste belegt. Darstellung ▸ Schnellterminal öffnet es weiterhin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune touche réservée. Présentation ▸ Terminal rapide l'ouvre toujours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se reserva ninguna tecla. Visualización ▸ Terminal rápido sigue abriéndolo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
