    "ui.presets.formatHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Shell und Verzeichnis benötigen absolute Pfade. Argumente werden durch Leerzeichen getrennt; für Anführungszeichen ein Skript verwenden. Umgebung: pro Zeile NAME=value."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell and directory use absolute paths. Arguments are space-separated; use a script for quoted arguments. Environment: one NAME=value per line."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa rutas absolutas. Separa los argumentos con espacios; usa un script si necesitan comillas. Variables: una línea NAME=value por variable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilisez des chemins absolus. Séparez les arguments par des espaces ; utilisez un script pour les guillemets. Variables : une ligne NAME=value par variable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "シェルとディレクトリは絶対パスで指定します。引数は空白区切りで、引用が必要ならスクリプトを使用してください。環境変数は1行にNAME=valueを指定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "셸과 디렉터리는 절대 경로를 사용하세요. 인수는 공백으로 구분하며 따옴표가 필요하면 스크립트를 사용하세요. 환경 변수는 줄마다 NAME=value를 입력하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Use caminhos absolutos. Separe os argumentos por espaços; use um script quando precisar de aspas. Variáveis: uma linha NAME=value por variável."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 与目录需为绝对路径。参数用空格分隔；需要引号时请使用脚本。环境变量每行填写 NAME=value。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 與目錄須為絕對路徑。引數以空格分隔；需要引號時請使用指令稿。環境變數每行填寫 NAME=value。"
          }
        }
      }
    },
    "ui.presets.help" : {
