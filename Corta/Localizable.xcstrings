    "failure.detail.metal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta draws the terminal with Metal, and this Mac reported no Metal device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta 使用 Metal 绘制终端，但这台 Mac 未报告任何 Metal 设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta 使用 Metal 繪製終端機，但這台 Mac 未回報任何 Metal 裝置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta は Metal でターミナルを描画しますが、この Mac は Metal デバイスを報告しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta는 Metal로 터미널을 그리지만 이 Mac은 Metal 장치를 보고하지 않았습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta zeichnet das Terminal mit Metal, doch dieser Mac hat kein Metal-Gerät gemeldet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta dessine le terminal avec Metal, mais ce Mac n’a signalé aucun appareil Metal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta dibuja el terminal con Metal, pero este Mac no informó de ningún dispositivo Metal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Corta desenha o terminal com o Metal, mas este Mac não informou nenhum dispositivo Metal."
          }
        }
      }
    },
    "failure.notice.fallbackDirectory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Started in your home directory — the previous working directory is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在主目录启动——之前的工作目录不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在主目錄啟動——先前的工作目錄無法使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームディレクトリで起動しました。以前の作業ディレクトリは利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 디렉터리에서 시작했습니다 — 이전 작업 디렉터리를 사용할 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Benutzerordner gestartet – das vorherige Arbeitsverzeichnis ist nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancé dans votre dossier de départ : le répertoire de travail précédent est indisponible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se inició en tu carpeta de inicio: el directorio de trabajo anterior no está disponible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciou na sua pasta pessoal — o diretório de trabalho anterior está indisponível."
          }
        }
      }
    },
    "failure.notice.fallbackShell": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Started %@ instead — the configured login shell could not run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已改用 %@ 启动——配置的登录 shell 无法运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
