    "settings.font.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta uses the system monospaced font. Set `font-family` in the config file to use another."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta 使用系统等宽字体。可在配置文件中设置 `font-family` 使用其他字体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta 使用系統等寬字型。可在設定檔中設定 `font-family` 使用其他字型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta はシステムの等幅フォントを使用します。別のフォントは設定ファイルの `font-family` で指定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta는 시스템 고정폭 글꼴을 사용합니다. 다른 글꼴은 구성 파일의 `font-family`로 지정할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta verwendet die Systemschrift mit fester Breite. Eine andere Schrift kann über `font-family` festgelegt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta utilise la police monospace du système. Définissez `font-family` dans le fichier de configuration pour en utiliser une autre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta usa la fuente monoespaciada del sistema. Define `font-family` en el archivo de configuración para usar otra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Corta usa a fonte monoespaçada do sistema. Defina `font-family` no arquivo de configuração para usar outra."
          }
        }
      }
    },
