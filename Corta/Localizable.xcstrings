    "sftp.host.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser Bereich ist mit einem entfernten Rechner verbunden, aber nicht bekannt, mit welchem. Gib den Rechner genau so ein, wie du ihn an ssh übergeben würdest:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This pane is connected to a remote host, but which one is not known. Enter the host exactly as you would pass it to ssh:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este panel está conectado a un host remoto, pero no se sabe a cuál. Escribe el host exactamente como se lo pasarías a ssh:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce volet est connecté à un hôte distant, mais on ne sait pas lequel. Saisissez l’hôte exactement comme vous le passeriez à ssh :"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このペインはリモートホストに接続されていますが、どのホストかは不明です。ssh に渡すのと同じ形でホストを入力してください:"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 패널은 원격 호스트에 연결되어 있지만 어떤 호스트인지 알 수 없습니다. ssh에 전달하는 것과 같은 형식으로 호스트를 입력하세요:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este painel está conectado a um host remoto, mas não se sabe qual. Digite o host exatamente como você o passaria ao ssh:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此窗格已连接到远程主机，但具体主机未知。请输入主机名，与传给 ssh 的写法一致："
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此面板已連線到遠端主機，但無法得知是哪一台。請輸入主機名稱，寫法與傳給 ssh 的相同："
          }
        }
      }
    },
    "sftp.host.suggestedMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Shell dieses Bereichs meldet, sie laufe auf „%@“. Dieser Name stammt aus der Ausgabe der entfernten Shell, nicht von Ihnen – prüfen Sie ihn (oder korrigieren Sie ihn zu dem, was Sie ssh übergeben würden) und verbinden Sie dann:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This pane's shell reported that it is on “%@”. That name came from the remote shell's output, not from you — check it (or correct it to what you would pass to ssh), then connect:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El shell de este panel informa que está en «%@». Ese nombre proviene de la salida del shell remoto, no de ti: compruébalo (o corrígelo a lo que pasarías a ssh) y luego conecta:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le shell de ce volet indique qu'il se trouve sur « %@ ». Ce nom provient de la sortie du shell distant, pas de vous : vérifiez-le (ou corrigez-le en ce que vous passeriez à ssh), puis connectez-vous :"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このペインのシェルは「%@」上にあると報告しました。この名前はリモートシェルの出力から得たもので、あなたが入力したものではありません。確認（または ssh に渡す形に修正）してから接続してください:"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 패널의 셸이 “%@”에 있다고 보고했습니다. 이 이름은 사용자가 입력한 것이 아니라 원격 셸의 출력에서 온 것입니다. 확인하거나 ssh에 전달할 형식으로 수정한 뒤 연결하세요:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O shell deste painel informou que está em “%@”. Esse nome veio da saída do shell remoto, não de você — confira (ou corrija para o que você passaria ao ssh) e então conecte:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此窗格的 shell 报告它位于“%@”。这个名字来自远端 shell 的输出，而不是你输入的——请核对（或改成你会传给 ssh 的写法），然后连接："
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此面板的 shell 回報它位於「%@」。這個名稱來自遠端 shell 的輸出，而不是你輸入的——請核對（或改成你會傳給 ssh 的寫法），然後連線："
          }
        }
      }
    },
