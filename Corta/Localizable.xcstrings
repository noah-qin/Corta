            "state": "needs_review",
            "value": "Columnas × filas. El tamaño de la ventana depende de la fuente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Colunas × linhas. O tamanho da janela acompanha a fonte."
