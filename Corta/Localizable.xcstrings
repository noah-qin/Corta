    "settings.help.directoryHistory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranks directories you have actually worked in (OSC 7), for the directory switcher. Nothing leaves the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "根据你实际工作过的目录（OSC 7）进行排序，供目录切换器使用。数据不会离开本应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "根據你實際工作過的目錄（OSC 7）進行排序，供目錄切換器使用。資料不會離開本應用程式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "実際に作業したディレクトリ（OSC 7）をランク付けし、ディレクトリ切り替えに使います。データはアプリの外へは出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "실제로 작업한 디렉터리(OSC 7)의 순위를 매겨 디렉터리 전환기에 사용합니다. 데이터는 앱 밖으로 나가지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bewertet Verzeichnisse, in denen tatsächlich gearbeitet wurde (OSC 7), für den Verzeichniswechsler. Nichts verlässt die App."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Classe les répertoires dans lesquels vous avez réellement travaillé (OSC 7), pour le sélecteur de répertoire. Rien ne quitte l’application."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Clasifica los directorios en los que realmente has trabajado (OSC 7), para el selector de directorios. Nada sale de la aplicación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Classifica os diretórios em que você realmente trabalhou (OSC 7), para o seletor de diretórios. Nada sai do aplicativo."
          }
        }
      }
    },
