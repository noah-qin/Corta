    "settings.help.openFileCommand" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wird ausgeführt, wenn eine „path:line“-Referenz in der Ausgabe bei gedrückter Befehlstaste angeklickt wird. {file}, {line} und {column} werden ersetzt. Der Befehl muss ein absoluter Pfad sein; leer lassen, um die Standardapp zu verwenden, der keine Zeilennummer übergeben werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs when a path:line reference in output is ⌘-clicked. {file}, {line} and {column} are substituted. The command must be an absolute path; leave empty to use the default app, which cannot be told a line number."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se ejecuta al hacer ⌘-clic en una referencia path:line de la salida. Se sustituyen {file}, {line} y {column}. El comando debe ser una ruta absoluta; déjalo vacío para usar la app por omisión, a la que no se le puede indicar el número de línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "S’exécute lorsqu’une référence path:line dans la sortie est cliquée avec ⌘. {file}, {line} et {column} sont remplacés. La commande doit être un chemin absolu ; laisser vide pour utiliser l’app par défaut, à laquelle le numéro de ligne ne peut pas être transmis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "出力中の path:line 参照を ⌘ クリックしたときに実行されます。{file}、{line}、{column} が置き換えられます。コマンドは絶対パスである必要があります。空欄にすると既定のアプリケーションを使用しますが、行番号は渡せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "출력의 path:line 참조를 ⌘-클릭할 때 실행됩니다. {file}, {line}, {column}이 치환됩니다. 명령은 절대 경로여야 합니다. 비워 두면 기본 응용 프로그램을 사용하지만 행 번호는 전달할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Executado ao clicar com ⌘ em uma referência path:line na saída. {file}, {line} e {column} são substituídos. O comando precisa ser um caminho absoluto; deixe vazio para usar o app padrão, que não recebe o número da linha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "当输出中的 path:line 引用被 ⌘ 点按时运行。{file}、{line} 和 {column} 会被替换。命令必须是绝对路径；留空则使用默认应用程序，但默认应用程序无法接收行号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "當輸出中的 path:line 參照被 ⌘ 點按時執行。{file}、{line} 和 {column} 會被替換。指令必須是絕對路徑；留空則使用預設應用程式，但預設應用程式無法接收行號。"
          }
        }
      }
    },
    "settings.help.optionAsMeta" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sendet ein Escape-Präfix, statt die Alternativzeichen der Tastaturbelegung zu erzeugen. Bei internationalen Belegungen und Tottasten ausgeschaltet lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends an Escape prefix instead of composing the layout's alternate characters. Leave off for international layouts and dead keys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envía un prefijo Escape en lugar de componer los caracteres alternativos de la distribución. Déjalo desactivado para distribuciones internacionales y teclas muertas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envoie un préfixe Escape au lieu de composer les caractères alternatifs de la disposition. À laisser désactivé pour les dispositions internationales et les touches mortes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "レイアウトの代替文字を入力する代わりに Escape プレフィックスを送信します。各国語レイアウトやデッドキーを使う場合はオフのままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "레이아웃의 대체 문자를 입력하는 대신 Escape 접두사를 보냅니다. 국제 키보드 레이아웃과 데드 키를 사용하는 경우 꺼 두십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envia um prefixo Escape em vez de compor os caracteres alternativos do layout. Deixe desativado para layouts internacionais e teclas mortas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "发送 Escape 前缀，而不是输入键盘布局的替代字符。使用国际键盘布局和死键时请保持关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "傳送 Escape 前綴，而不是輸入鍵盤佈局的替代字元。使用國際鍵盤佈局和附加符號鍵時請保持關閉。"
          }
        }
      }
    },
    "settings.help.quickTerminal" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Standardmäßig aus: Die Taste wird in jeder App belegt. Das Panel ist immer über Darstellung ▸ Schnellterminal, die Befehlspalette und die Kurzbefehle-App erreichbar; hier wird nur der Kurzbefehl hinzugefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off by default: the key is claimed in every application. The panel is always available from View ▸ Quick Terminal, the command palette and the Shortcuts app; this only adds the hotkey."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desactivado por defecto: la tecla se reserva en todas las apps. El panel siempre está disponible desde Visualización ▸ Terminal rápido, la paleta de comandos y la app Atajos; esto solo añade el atajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Désactivé par défaut : la touche est réservée dans toutes les apps. Le panneau reste accessible via Présentation ▸ Terminal rapide, la palette de commandes et l'app Raccourcis ; ce réglage ajoute seulement le raccourci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "デフォルトはオフ: キーはすべてのアプリで占有されます。パネルは常に「表示 ▸ クイックターミナル」、コマンドパレット、ショートカットアプリから開けます。この設定はホットキーを追加するだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "기본값은 꺼짐: 이 키는 모든 앱에서 점유됩니다. 패널은 항상 보기 ▸ 퀵 터미널, 명령 팔레트, 단축어 앱에서 열 수 있으며 이 설정은 단축키만 추가합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desativado por padrão: a tecla é reservada em todos os apps. O painel está sempre disponível em Visualização ▸ Terminal rápido, na paleta de comandos e no app Atalhos; isto só adiciona o atalho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "默认关闭：该按键会在所有应用中被占用。面板始终可通过“显示 ▸ 快捷终端”、命令面板和“快捷指令”打开；此设置只负责添加热键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "預設關閉：該按鍵會在所有應用程式中被佔用。面板始終可透過「檢視 ▸ 快捷終端機」、指令面板和「捷徑」開啟；此設定只負責加入快速鍵。"
          }
        }
      }
    },
    "settings.help.scrollback" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pro Sitzung gespeicherte Zeilen; gilt für neue Sitzungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lines kept per session; applies to new sessions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Líneas conservadas por sesión; se aplica a sesiones nuevas."
          }
        },
        "fr" : {
          "stringUnit" : {
