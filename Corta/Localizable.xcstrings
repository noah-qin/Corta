    "sftp.error.hostKey" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Hostschlüssel von %1$@ konnte nicht überprüft werden:\n%2$@\n\nDie SFTP-Verbindung hat kein Terminal, daher kann ssh Sie hier nicht bitten, einen neuen oder geänderten Hostschlüssel zu akzeptieren. Verbinden Sie sich zuerst einmal im Terminal, prüfen und akzeptieren Sie ihn, und versuchen Sie es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host key of %1$@ could not be verified:\n%2$@\n\nThe SFTP connection has no terminal, so ssh cannot ask you to accept a new or changed host key here. Connect once in the terminal to review and accept it, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudo verificar la clave de host de %1$@:\n%2$@\n\nLa conexión SFTP no tiene terminal, así que ssh no puede pedirte aquí que aceptes una clave de host nueva o cambiada. Conecta primero una vez en el terminal para revisarla y aceptarla, y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La clé d'hôte de %1$@ n'a pas pu être vérifiée :\n%2$@\n\nLa connexion SFTP n'a pas de terminal : ssh ne peut donc pas vous demander ici d'accepter une clé d'hôte nouvelle ou modifiée. Connectez-vous d'abord une fois dans le terminal pour la vérifier et l'accepter, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ のホスト鍵を検証できませんでした:\n%2$@\n\nSFTP 接続には端末がないため、ssh はここで新しい、または変更されたホスト鍵の受け入れを尋ねられません。先に端末で一度接続して確認・受け入れてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@의 호스트 키를 확인할 수 없습니다:\n%2$@\n\nSFTP 연결에는 터미널이 없어 ssh가 여기서 새 호스트 키나 변경된 호스트 키의 수락을 물을 수 없습니다. 먼저 터미널에서 한 번 연결해 검토하고 수락한 뒤 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A chave de host de %1$@ não pôde ser verificada:\n%2$@\n\nA conexão SFTP não tem terminal, então o ssh não pode pedir aqui que você aceite uma chave de host nova ou alterada. Conecte uma vez no terminal para revisá-la e aceitá-la, depois tente de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "无法验证 %1$@ 的主机密钥：\n%2$@\n\nSFTP 连接没有终端，ssh 在这里无法请你接受新的或已变更的主机密钥。请先在终端里连接一次，审核并接受后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "無法驗證 %1$@ 的主機金鑰：\n%2$@\n\nSFTP 連線沒有終端機，ssh 在這裡無法請你接受新的或已變更的主機金鑰。請先在終端機裡連線一次，審核並接受後再試。"
          }
        }
      }
    },
