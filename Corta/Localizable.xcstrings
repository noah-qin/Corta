        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” isn't installed — using System Monospaced instead"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未安装“%@”——已改用系统等宽字体"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未安裝「%@」——已改用系統等寬字體"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%@」はインストールされていません — 代わりにシステム等幅フォントを使用しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”이(가) 설치되어 있지 않습니다 — 대신 시스템 고정폭 글꼴을 사용합니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ ist nicht installiert – stattdessen wird die System-Festbreitenschrift verwendet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« %@ » n'est pas installée — utilisation de la police à chasse fixe du système à la place"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” no está instalada; se usa la fuente monoespaciada del sistema en su lugar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” não está instalada — usando a fonte monoespaçada do sistema"
          }
        }
      }
    },
    "settings.status.fontInvalidForGrid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” doesn't advance evenly and can't be used — using System Monospaced instead"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”字宽不均匀，无法使用——已改用系统等宽字体"
