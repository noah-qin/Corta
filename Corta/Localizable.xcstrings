    "settings.help.openFileCommand": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs when a path:line reference in output is ⌘-clicked. {file}, {line} and {column} are substituted. The command must be an absolute path; leave empty to use the default app, which cannot be told a line number."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当输出中的 path:line 引用被 ⌘ 点按时运行。{file}、{line} 和 {column} 会被替换。命令必须是绝对路径；留空则使用默认应用程序，但默认应用程序无法接收行号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當輸出中的 path:line 參照被 ⌘ 點按時執行。{file}、{line} 和 {column} 會被替換。指令必須是絕對路徑；留空則使用預設應用程式，但預設應用程式無法接收行號。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力中の path:line 参照を ⌘ クリックしたときに実行されます。{file}、{line}、{column} が置き換えられます。コマンドは絶対パスである必要があります。空欄にすると既定のアプリケーションを使用しますが、行番号は渡せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출력의 path:line 참조를 ⌘-클릭할 때 실행됩니다. {file}, {line}, {column}이 치환됩니다. 명령은 절대 경로여야 합니다. 비워 두면 기본 응용 프로그램을 사용하지만 행 번호는 전달할 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird ausgeführt, wenn eine „path:line“-Referenz in der Ausgabe bei gedrückter Befehlstaste angeklickt wird. {file}, {line} und {column} werden ersetzt. Der Befehl muss ein absoluter Pfad sein; leer lassen, um die Standardapp zu verwenden, der keine Zeilennummer übergeben werden kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’exécute lorsqu’une référence path:line dans la sortie est cliquée avec ⌘. {file}, {line} et {column} sont remplacés. La commande doit être un chemin absolu ; laisser vide pour utiliser l’app par défaut, à laquelle le numéro de ligne ne peut pas être transmis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ejecuta al hacer ⌘-clic en una referencia path:line de la salida. Se sustituyen {file}, {line} y {column}. El comando debe ser una ruta absoluta; déjalo vacío para usar la app por omisión, a la que no se le puede indicar el número de línea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executado ao clicar com ⌘ em uma referência path:line na saída. {file}, {line} e {column} são substituídos. O comando precisa ser um caminho absoluto; deixe vazio para usar o app padrão, que não recebe o número da linha."
          }
        }
      }
    },
    "settings.status.openFileCommand": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Open file with” needs an absolute path and only {file}, {line} and {column}; it was left unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“打开文件方式”需要绝对路径，且只能使用 {file}、{line} 和 {column}；已保持原值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「打開檔案方式」需要絕對路徑，且只能使用 {file}、{line} 和 {column}；已保持原值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ファイルを開くコマンド」には絶対パスと {file}、{line}、{column} のみを指定できます。変更していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘파일 열기 명령’에는 절대 경로와 {file}, {line}, {column}만 사용할 수 있습니다. 변경하지 않았습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Datei öffnen mit“ benötigt einen absoluten Pfad und nur {file}, {line} und {column}; die Einstellung wurde nicht geändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Ouvrir le fichier avec » nécessite un chemin absolu et uniquement {file}, {line} et {column} ; la valeur n’a pas été modifiée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Abrir archivo con” necesita una ruta absoluta y solo {file}, {line} y {column}; no se ha modificado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Abrir arquivo com” precisa de um caminho absoluto e apenas {file}, {line} e {column}; o valor não foi alterado."
          }
        }
      }
    },
