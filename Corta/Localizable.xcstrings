    "sftp.error.hostKey" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Host-Schlüssel von %1$@ konnte nicht überprüft werden:\n%2$@\n\nEin Schlüssel, der sich seit dem Vertrauen geändert hat, wird abgelehnt, bis sein alter Eintrag aus ~/.ssh/known_hosts entfernt ist. Fragen Sie vorher beim Administrator des Servers nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host key of %1$@ could not be verified:\n%2$@\n\nA key that changed since it was trusted is refused until its old entry is removed from ~/.ssh/known_hosts. Check with the server’s administrator before you remove it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudo verificar la clave de host de %1$@:\n%2$@\n\nUna clave que cambió después de aceptarla se rechaza hasta que se elimine su entrada antigua de ~/.ssh/known_hosts. Consulta con el administrador del servidor antes de eliminarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La clé d'hôte de %1$@ n'a pas pu être vérifiée :\n%2$@\n\nUne clé qui a changé depuis qu'elle a été approuvée est refusée tant que son ancienne entrée n'est pas retirée de ~/.ssh/known_hosts. Vérifiez auprès de l'administrateur du serveur avant de la retirer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ のホスト鍵を検証できませんでした:\n%2$@\n\n信頼した後に変わった鍵は、~/.ssh/known_hosts から古いエントリを削除するまで拒否されます。削除する前にサーバ管理者に確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@의 호스트 키를 확인할 수 없습니다:\n%2$@\n\n신뢰한 뒤에 바뀐 키는 ~/.ssh/known_hosts에서 이전 항목을 지울 때까지 거부됩니다. 지우기 전에 서버 관리자에게 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Não foi possível verificar a chave de host de %1$@:\n%2$@\n\nUma chave que mudou depois de ser aceita é recusada até que sua entrada antiga seja removida de ~/.ssh/known_hosts. Confirme com o administrador do servidor antes de removê-la."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法验证 %1$@ 的主机密钥：\n%2$@\n\n信任之后又发生变化的密钥会被拒绝，直到从 ~/.ssh/known_hosts 删除旧条目。删除之前请先向服务器管理员确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "無法驗證 %1$@ 的主機金鑰：\n%2$@\n\n信任之後又發生變化的金鑰會被拒絕，直到從 ~/.ssh/known_hosts 刪除舊項目。刪除之前請先向伺服器管理員確認。"
          }
        }
      }
    },
