    "status.settings.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur lokale Werte. Hostdetails per Klick. Verborgene Leisten stoppen die Messung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local metrics only. Click the bar for host details. Sampling stops when hidden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo métricas locales. Haz clic para ver detalles. El muestreo se detiene al ocultar la barra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesures locales uniquement. Cliquez pour les détails. La collecte s’arrête quand la barre est masquée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルの指標のみ表示します。バーをクリックするとホスト情報を表示します。非表示時は測定を停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 지표만 표시합니다. 표시줄을 클릭하면 호스트 정보가 표시됩니다. 숨겨지면 수집이 중지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente métricas locais. Clique para ver detalhes. A coleta para quando a barra é ocultada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅显示本机指标。点击状态栏查看主机详情，隐藏后停止采样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅顯示本機指標。點擊狀態列查看主機詳情，隱藏後停止取樣。"
          }
        }
      }
    },
