# Optional. Paths are relative to website/. The default already reads Corta root.
CORTA_CONTENT_DIR=..
NEXT_PUBLIC_BASE_PATH=
# Local only. CI/deployment requires the real public HTTPS origin (without a path).
SITE_URL=http://localhost:3000
# WEBSITE_DEPLOYMENT=1 enables the same strict validation outside CI.
